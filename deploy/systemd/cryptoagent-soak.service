# Soak test unit (paper, separate state): restarts on any exit so crash recovery can be exercised.
[Unit]
Description=Crypto agent SOAK TEST (paper)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Desktop/github_repos/crypto-agent
ExecStart=%h/Desktop/github_repos/crypto-agent/.venv/bin/cryptoagent --config config/agent.soak.yaml run
Restart=always
RestartSec=20
MemoryMax=2G
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
